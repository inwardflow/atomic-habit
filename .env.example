# Docker Compose
# AI model configuration (OpenAI-compatible API, e.g. SiliconFlow)
AGENTSCOPE_MODEL_API_KEY=your-api-key-here
AGENTSCOPE_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
AGENTSCOPE_MODEL_BASE_URL=https://api.siliconflow.com/v1
# Optional: HTTP proxy for AI model calls only
# AGENTSCOPE_PROXY_ENABLED=true
# AGENTSCOPE_PROXY_HOST=127.0.0.1
# AGENTSCOPE_PROXY_PORT=7890
POSTGRES_DB=atomic_habits
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Backend
# Required in prod. Generate with: openssl rand -hex 32
SPRING_JWT_SECRET=replace_with_64_char_hex
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/atomic_habits
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# CORS: comma-separated list of allowed origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend environment variables (set in frontend/.env or at build time)
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_BACKEND_URL=http://localhost:8080
